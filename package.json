{
  "name": "opal",
  "private": true,
  "version": "1.0.1-rc3",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "OPAL Team",
  "description": "Orcaslicer Pressure Advance Lab",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "concurrently \"npm run dev\" \"wait-on tcp:3001 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.opal.lab",
    "productName": "OPAL",
    "artifactName": "${productName} Setup ${version}.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "EULA.txt",
      "USER_MANUAL.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/opal-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "EULA.txt",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerSidebar": "build/installerSidebar.bmp"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/opal-icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/opal-icon.png"
    }
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.3"
  }
}
